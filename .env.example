# GGCB Alumni Portal — environment variable reference (names only).
# Copy to .env.local for development and fill in real values locally.
# NEVER commit real values. Names follow context.md §7-14.

# --- Database (Prompt 2) ---
# Pooled Postgres connection string (Supabase pooler, prepare:false).
DATABASE_URL=
# Direct (non-pooled) Postgres connection — migrations only.
DIRECT_URL=

# --- Auth (Prompt 3, NextAuth v5) ---
# Session/JWT signing secret (>= 32 chars, generated).
AUTH_SECRET=
# Canonical app URL used by NextAuth.
AUTH_URL=
# "true" on Vercel — tells Auth.js to trust the proxy host.
AUTH_TRUST_HOST=

# --- Transactional email (Prompt 4, outbox + nodemailer) ---
# off (default) | log (dev/test ONLY — refused in production) | smtp
EMAIL_MODE=off
# Required when EMAIL_MODE=smtp:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# "true" for implicit TLS (port 465), "false" for STARTTLS (required).
SMTP_SECURE=false
# Sender identity (required when smtp).
FROM_EMAIL=
FROM_NAME=
# Optional Reply-To for all outgoing mail.
REPLY_TO_EMAIL=
# Worker tuning (all optional; defaults shown).
EMAIL_BATCH_SIZE=20
EMAIL_CONCURRENCY=2
EMAIL_RUN_BUDGET_MS=20000
EMAIL_STALE_LOCK_SECONDS=300

# --- Supabase (server-side Storage ONLY — never expose to the browser) ---
# Optional until the upload phase flips them to required.
SUPABASE_URL=
# Service role key — server-only env var, bypasses RLS; never log it.
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket name for photos/attachments.
STORAGE_BUCKET_PRIVATE=

# --- Internal ---
# Bearer secret protecting the Vercel Cron drain route. >= 32 chars,
# REQUIRED in production when EMAIL_MODE is not "off".
CRON_SECRET=
# Dev-only: "true" enables the DB query fan-out counter (context.md §7).
DB_QUERY_STATS=false
# Runtime pool size for the postgres.js client (default 3).
DB_POOL_MAX=3

# --- Script-scoped (Prompt 2) ---
# Superadmin seed inputs (names only; Prompt 3 adds the set-password flow).
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_NAME=
# Real-DB test targets — must point at a LOCAL database named *test*.
TEST_DIRECT_URL=
TEST_DATABASE_URL=
# Set to "yes" to run migrations against a non-local host (acknowledged target).
MIGRATE_CONFIRM=

# --- Public (inlined into client bundle — no secrets, ever) ---
# Canonical site URL for absolute links/metadata.
NEXT_PUBLIC_APP_URL=
